# Public gateway/listener.
# The Go gateway intentionally uses the historical UVICORN_* names.
UVICORN_HOST = "0.0.0.0"
UVICORN_PORT = 8000
# NORA_GATEWAY_ADDR = ":8000"
# NORA_PROXY_PROTOCOL = false
# NORA_PROXY_PROTOCOL_POLICY = "use" # "use" (accepts PROXY header or direct connections) or "require" (strict)
# NORA_PROXY_PROTOCOL_TRUSTED = "" # IPs or CIDRs allowed to send a PROXY header; empty means loopback and private ranges

# Gateway TLS.
# UVICORN_SSL_CERTFILE = "/var/lib/nora/certs/example.com/fullchain.pem"
# UVICORN_SSL_KEYFILE = "/var/lib/nora/certs/example.com/key.pem"
# UVICORN_SSL_CA_TYPE = "public"

# Database.
# SQLALCHEMY_DATABASE_URL = "sqlite:///db.sqlite3"

# Binary/install metadata.
# NORA_INSTALL_MODE = "binary"
# NORA_SCRIPT_BIN = "/usr/local/bin/nora"
# NORA_APP_DIR = "/opt/nora"
# NORA_DATA_DIR = "/var/lib/nora"
# NORA_SERVICE_NAME = "nora"

# Initial admin bootstrap.

# Node operations and user lifecycle jobs.
# NORA_NODE_OPERATIONS_POLL_INTERVAL = "15s"
# NORA_NODE_USAGE_COLLECTION_INTERVAL = "30s"
# NORA_NODE_USAGE_COLLECTION_LIMIT = 0
# NORA_USER_LIFECYCLE_INTERVAL = "10s"
# NORA_USER_LIFECYCLE_BATCH_SIZE = 500
# NORA_USER_USAGE_RESET_INTERVAL = "1h"
# NORA_USER_USAGE_RESET_BATCH_SIZE = 500
# NORA_USER_AUTODELETE_INTERVAL = "1h"
# NORA_USER_AUTODELETE_BATCH_SIZE = 500
# USERS_AUTODELETE_DAYS = -1
# USER_AUTODELETE_INCLUDE_LIMITED_ACCOUNTS = false

# API behavior.
# JWT_ACCESS_TOKEN_EXPIRE_MINUTES = 1440
# USERS_LIST_TIMEOUT_SECONDS = 0

# Settings, templates, certificates, and backup roots.
# NORA_CERT_BASE = "/var/lib/nora/certs"
# NORA_CONFIG_DIR = "/etc/nora"
